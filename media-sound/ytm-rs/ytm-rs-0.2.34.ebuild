RUST_MIN_VER="1.95.0"

inherit cargo desktop xdg

DESCRIPTION="Native YouTube Music desktop client written in Rust (egui, rodio)"
HOMEPAGE="https://grapedjuice.github.io/ytm-rs/ https://github.com/grapedjuice/ytm-rs"
SRC_URI="
	https://github.com/grapedjuice/ytm-rs/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3"
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0 ISC
	MIT MPL-2.0 OFL-1.1 UbuntuFontLicense-1.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="amd64"
RESTRICT="test"

DEPEND="
	app-accessibility/at-spi2-core:2
	dev-libs/glib:2
	dev-libs/openssl:=
	media-libs/alsa-lib
	media-libs/fontconfig
	net-libs/libsoup:3.0
	net-libs/webkit-gtk:4.1
	sys-apps/dbus
	x11-libs/cairo
	x11-libs/gdk-pixbuf:2
	x11-libs/gtk+:3
	x11-libs/pango
"
RDEPEND="
	${DEPEND}
	dev-libs/libayatana-appindicator
	dev-libs/wayland
	media-libs/libglvnd
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxcb
	x11-libs/libxkbcommon
	x11-misc/xdg-utils
"
BDEPEND="
	dev-lang/nasm
	virtual/pkgconfig
"

src_install() {
	dobin "$(cargo_target_dir)"/ytm-rs

	domenu "${FILESDIR}"/ytm-rs.desktop
	doicon -s 256 "${FILESDIR}"/ytm-rs.png

	dodoc README.md
}

pkg_postinst() {
	xdg_pkg_postinst

	elog "Run 'ytm-rs' or open 'YT Music' from the application menu."
	elog "Sign in through Settings -> Sign in with Google (needs WebKitGTK, pulled in)."
	elog "Sign-ins are stored in the Secret Service keyring (KWallet or GNOME Keyring)."
	elog ""
	elog "The built-in self-updater is inactive for this system-wide install;"
	elog "updates come through this package."
}
